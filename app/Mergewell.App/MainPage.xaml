<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Mergewell_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Mergewell_App.ViewModels"
    AllowDrop="True" Background="{ThemeResource AppBackgroundBrush}" RequestedTheme="Light"
    DragOver="Page_DragOver" Drop="Page_Drop" KeyDown="Page_KeyDown" Loaded="Page_Loaded" mc:Ignorable="d">

    <Grid>
    <Grid x:Name="MainContent" Padding="28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border MaxWidth="760" HorizontalAlignment="Stretch" Padding="28,20"
                Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="8">
            <StackPanel HorizontalAlignment="Stretch" Spacing="10">
                <Border Width="44" Height="44" HorizontalAlignment="Center"
                        Background="{ThemeResource AppSurfaceMutedBrush}" CornerRadius="22">
                    <FontIcon Foreground="{ThemeResource AppAccentBrush}" FontSize="20" Glyph="&#xE898;" />
                </Border>
                <StackPanel Spacing="5">
                    <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource AppTextBrush}"
                               FontSize="21" FontWeight="SemiBold" Text="Drop a folder, ZIP, or RAR here"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource AppSecondaryTextBrush}"
                               Text="Merge Word documents and PDFs"
                               TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock MaxWidth="620" HorizontalAlignment="Center" Foreground="{ThemeResource AppAccentBrush}"
                           FontWeight="SemiBold" Text="{x:Bind ViewModel.SelectedInputName, Mode=OneWay}"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Button Click="UploadFolder_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontSize="14" Glyph="&#xE8B7;" /><TextBlock Text="Folder" /></StackPanel>
                    </Button>
                    <Button Click="UploadArchive_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontSize="14" Glyph="&#xE8B5;" /><TextBlock Text="Archive" /></StackPanel>
                    </Button>
                    <Button Click="Start_Click" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontSize="14" Glyph="&#xE768;" /><TextBlock Text="Start merge" /></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Spacing="7" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Foreground="{ThemeResource AppTextBrush}" FontWeight="SemiBold" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Foreground="{ThemeResource AppSecondaryTextBrush}" Text="{x:Bind ViewModel.CurrentFile, Mode=OneWay}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ProgressBar Height="5" Foreground="{ThemeResource AppAccentBrush}" Maximum="100" Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <InfoBar Grid.Row="1" MaxWidth="760" HorizontalAlignment="Center" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" Title="Merge could not be completed" />

        <Grid Grid.Row="2" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock Foreground="{ThemeResource AppTextBrush}" FontSize="20" FontWeight="SemiBold" Text="Merges" />
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Merges}" SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:MergeJobRowViewModel">
                        <Border Padding="16,12" Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Foreground="{ThemeResource AppTextBrush}" FontWeight="SemiBold" Text="{x:Bind OriginalInputName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" FontSize="12" Text="{x:Bind CreatedAtText}" />
                                </StackPanel>
                                <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="9,4"
                                        Background="{ThemeResource AppSurfaceMutedBrush}" CornerRadius="4">
                                    <TextBlock Foreground="{ThemeResource AppAccentBrush}" FontSize="12" FontWeight="SemiBold" Text="{x:Bind StatusText, Mode=OneWay}" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" Text="{x:Bind ProgressText, Mode=OneWay}" />
                                    <TextBlock Foreground="{ThemeResource AppAccentBrush}" FontSize="12" FontWeight="SemiBold" Text="{x:Bind PageCountText, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                    <Button Click="CancelMerge_Click" IsEnabled="{x:Bind CanCancel, Mode=OneWay}" Style="{StaticResource IconActionButtonStyle}" Tag="{x:Bind}" ToolTipService.ToolTip="Cancel processing"><FontIcon FontSize="14" Glyph="&#xE711;" /></Button>
                                    <Button Click="OpenOutput_Click" IsEnabled="{x:Bind CanOpenOutput, Mode=OneWay}" Style="{StaticResource IconActionButtonStyle}" Tag="{x:Bind}" ToolTipService.ToolTip="Open merged PDF"><FontIcon FontSize="14" Glyph="&#xE8A7;" /></Button>
                                    <Button Click="OpenFolder_Click" IsEnabled="{x:Bind CanOpenFolder, Mode=OneWay}" Style="{StaticResource IconActionButtonStyle}" Tag="{x:Bind}" ToolTipService.ToolTip="Open folder location"><FontIcon FontSize="14" Glyph="&#xED25;" /></Button>
                                    <Button Click="DeleteMerge_Click" IsEnabled="{x:Bind CanDelete, Mode=OneWay}" Style="{StaticResource IconActionButtonStyle}" Tag="{x:Bind}" ToolTipService.ToolTip="Delete merge"><FontIcon Foreground="{ThemeResource AppDangerBrush}" FontSize="14" Glyph="&#xE74D;" /></Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>

        <Grid x:Name="DialogOverlay" Canvas.ZIndex="10" Background="#660B1F33" TabFocusNavigation="Cycle" Visibility="Collapsed">
            <Border MaxWidth="460" HorizontalAlignment="Stretch" Margin="24"
                    VerticalAlignment="Center" Padding="24" Background="#FFFFFF" BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="20">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" Background="#FDE7E9" CornerRadius="21">
                            <FontIcon Foreground="{ThemeResource AppDangerBrush}" FontSize="18" Glyph="&#xE74D;" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock x:Name="DialogTitle" Foreground="{ThemeResource AppTextBrush}" FontSize="18"
                                       FontWeight="SemiBold" Text="Delete merge?" />
                            <TextBlock x:Name="DialogMessage" Foreground="{ThemeResource AppSecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource AppBorderBrush}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="KeepDialogButton" MinWidth="92" Click="CloseDialog_Click" Content="Keep" />
                        <Button MinWidth="92" Click="ConfirmDelete_Click" Background="#C42B1C" Foreground="White"
                                BorderBrush="#C42B1C" Content="Delete" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>