<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Mergewell_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mergewell_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F7FBFF" />
                    <SolidColorBrush x:Key="AppSurfaceMutedBrush" Color="#EAF3FD" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#C9DDF3" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#102A43" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#526D82" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#0F6CBD" />
                    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#115EA3" />
                    <SolidColorBrush x:Key="AppDangerBrush" Color="#C42B1C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#081525" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#10243B" />
                    <SolidColorBrush x:Key="AppSurfaceMutedBrush" Color="#163554" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#28547A" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#F1F7FD" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#A9C2D8" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#60AEEF" />
                    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#7ABCF2" />
                    <SolidColorBrush x:Key="AppDangerBrush" Color="#FF99A4" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16,9" />
            </Style>
            <Style x:Key="IconActionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
